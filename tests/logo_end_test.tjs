// Integration fixture: supply the host game's time-based logo PSB and metadata.
// Inspect the saved alpha images: hidden parts must not reappear at the motion's
// final delimiter, and the image must remain empty after playback has ended.
function captureEmoteLogoEnd(manager, path, metadata, parent, output) {
  var player = new Motion.EmotePlayer(manager);
  player.motionKey = Storages.getPlacedPath(path);
  player.chara = metadata.base.chara;
  player.play(metadata.base.motion, Motion.PlayFlagForce);
  player.completionType = stFastLinear;
  player.maskMode = Motion.MaskModeAlpha;
  player.useD3D = false;
  player.setCameraOffset(640, 360);
  var layer = new Layer(kag, parent);
  layer.setSize(1280, 720);
  layer.setImageSize(1280, 720);
  layer.type = ltAlpha;
  var checkpoints = [0, 108, 129, 143, 144, 145, 227, 239, 240, 241, 242, 260, 360];
  var previous = 0;
  var log = [];
  for (var i = 0; i < checkpoints.count; i++) {
    var frame = checkpoints[i];
    player.progress((frame - previous) * 1000.0 / 60);
    previous = frame;
    layer.fillRect(0, 0, 1280, 720, 0);
    player.draw(layer);
    layer.saveLayerImage(output + "/frame_" + frame + ".bmp", "bmp");
    log.add(frame + "," + player.animating);
  }
  log.save(output + "/logo-end.csv");
}
